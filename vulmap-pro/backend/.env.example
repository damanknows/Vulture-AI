# Vulmap Pro backend configuration
# Copy to `.env` (which is gitignored) and fill in your secrets.

# Database (defaults to SQLite in the project root)
# DB_URL=sqlite:///./vulmap.db

# NVD API key — request at https://nvd.nist.gov/developers/request-an-api-key
# Without a key NVD allows ~5 requests per 30 seconds; with one, ~50 per 30s.
NVD_API_KEY=

# Optional: extra targets (comma-separated IPs/CIDRs) that may be scanned
# beyond the default loopback + RFC1918 allowlist. Use only on trusted hosts.
# ALLOWED_TARGETS=10.0.0.0/8,192.168.50.10

# Nmap binary path
# NMAP_BINARY=nmap

# Scan timeout in seconds
# SCAN_TIMEOUT_SECONDS=900

# Comma-separated CORS origins
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
