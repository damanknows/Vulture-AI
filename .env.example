# Vulture-AI Environment Configuration Template
# ===================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit your production .env with secret keys to version control.

# --- Security & Network Scope ---
# Comma-separated list of IP addresses or hostnames authorized for scanning.
# Unlisted targets will be rejected by is_target_allowed() in scanner.py.
VULTURE_ALLOWED_TARGETS=127.0.0.1,localhost

# Allowed CORS origins for Flask web API
VULTURE_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Threat Intelligence APIs ---
# NIST National Vulnerability Database API key (optional, increases rate limit)
NVD_API_KEY=

# Local cache directory for NVD, EPSS, and KEV responses
VULTURE_CACHE_DIR=data/cache

# --- AI & LLM Configuration ---
# Model target for LiteLLM router (e.g., ollama/llama3.2, gpt-4o, etc.)
MODEL_NAME=ollama/llama3.2

# Ollama local endpoint
OLLAMA_API_BASE=http://localhost:11434

# Optional: Commercial API keys (only required if NOT using local Ollama)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Application Server ---
FLASK_ENV=development
PORT=5000
